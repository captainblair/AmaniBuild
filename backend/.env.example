# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api
# manage.py defaults to config.settings.local (SQLite, no Docker).
# Docker Compose should use development (PostGIS).
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (only used by development/production — local settings use SQLite)
# Use localhost when running manage.py on the host machine.
# docker-compose overrides these to db/redis/minio service names for the api container.
DATABASE_URL=postgis://amanibuild:amanibuild@localhost:5432/amanibuild

# Redis / Celery (optional — leave empty to skip Redis)
REDIS_URL=

# CORS (Next.js dev server)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object storage (MinIO — enable when using docker-compose)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=amanibuild
AWS_SECRET_ACCESS_KEY=amanibuildsecret
AWS_STORAGE_BUCKET_NAME=amanibuild
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO

# Auth (development only — never enable in production)
# Local/dev: return debug_otp in API responses so the UI can show the code on screen
AMANIBUILD_EXPOSE_OTP=True
AMANIBUILD_EXPOSE_INVITE_TOKEN=False

# Google Sign-In (same Web client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
